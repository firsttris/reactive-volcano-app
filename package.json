{
  "name": "volcano-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "typecheck": "npm run i18n && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "npm run i18n && tsc && vite build --base=/reactive-volcano-app/",
    "build:root": "npm run i18n && tsc && vite build",
    "preview": "vite preview",
    "icons": "node scripts/icons/generate.mjs",
    "test": "npm run i18n && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "npm run i18n && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.52.0",
    "p-queue": "^9.3.3",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.2"
  }
}
