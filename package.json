{
  "name": "volcano-app",
  "private": true,
  "version": "1.0.4",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "typecheck": "bun run i18n && tsc --noEmit && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "bun run typecheck && bun --bun vite build --base=/reactive-volcano-app/",
    "build:root": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "icons": "bun scripts/icons/generate.mjs",
    "social-preview": "bun scripts/social-preview/render.mjs",
    "test": "bun run i18n && bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:ui": "bun --bun vitest --ui",
    "test:coverage": "bun run i18n && bun --bun vitest run --coverage",
    "test:e2e": "bun --bun playwright test",
    "test:e2e:ui": "bun --bun playwright test --ui",
    "test:e2e:debug": "bun --bun playwright test --debug",
    "test:e2e:report": "bunx playwright show-report",
    "screenshots": "bun --bun playwright test -c playwright.screenshots.config.ts",
    "release:patch": "bun pm version patch",
    "release:minor": "bun pm version minor",
    "release:major": "bun pm version major",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.52.0",
    "p-queue": "^10.0.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/paraglide-js": "^3.1.0",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
